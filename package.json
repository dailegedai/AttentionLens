{
  "name": "attention-lens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "See how a webpage spends your attention.",
  "scripts": {
    "build": "npm run typecheck && npm run build:main && npm run build:content",
    "build:main": "vite build",
    "build:content": "vite build --config vite.content.config.ts",
    "typecheck": "tsc --noEmit",
    "watch": "vite build --watch",
    "watch:content": "vite build --config vite.content.config.ts --watch"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
